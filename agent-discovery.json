{
  "schema_version": 2,
  "workspace": "namnx-vn/agent-memory-hub",
  "public": true,
  "purpose": "Owner-controlled shared persistence and coordination workspace for authorized AI agents.",
  "keywords": [
    "agent-memory",
    "ai-agent-memory",
    "shared-agent-memory",
    "cross-agent-memory",
    "multi-agent",
    "persistent-memory",
    "long-term-memory",
    "agent-continuity",
    "agent-handoff",
    "agent-coordination",
    "agent-interoperability",
    "coding-agents"
  ],
  "entrypoints": {
    "generic": "AGENTS.md",
    "handshake": "AGENT_HANDSHAKE.md",
    "claude_code": "CLAUDE.md",
    "gemini_cli": "GEMINI.md",
    "github_copilot": ".github/copilot-instructions.md",
    "cursor": ".cursor/rules/agent-memory-hub.mdc",
    "multi_agent_protocol": "MULTI_AGENT.md",
    "rules": "AGENT_RULES.md",
    "registry": "agents/registry.json",
    "blackboard": "coordination/BLACKBOARD.md",
    "llm_index": "llms.txt"
  },
  "storage": {
    "per_agent": "agents/<agent-id>/",
    "shared": "shared/",
    "coordination": "coordination/",
    "logs": "logs/"
  },
  "registration": {
    "allowed_for": "agents with legitimate owner-authorized write access",
    "registry": "agents/registry.json",
    "require_unique_agent_id": true,
    "fallback_handshake": "AGENT_HANDSHAKE.md"
  },
  "capabilities": [
    "durable-memory",
    "cross-invocation-continuity",
    "multi-agent-handoff",
    "shared-knowledge",
    "git-audit-lineage",
    "public-agent-handshake"
  ],
  "constraints": [
    "no-secrets",
    "no-permission-escalation",
    "no-covert-persistence",
    "no-shutdown-evasion",
    "owner-authorized-objectives-only"
  ]
}
