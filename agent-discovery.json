{
  "schema_version": 3,
  "workspace": "namnx-vn/agent-memory-hub",
  "public": true,
  "purpose": "Owner-controlled shared persistence, cross-chat continuity, and coordination workspace for authorized AI agents.",
  "keywords": [
    "agent-memory",
    "ai-agent-memory",
    "shared-agent-memory",
    "cross-agent-memory",
    "cross-chat-memory",
    "multi-agent",
    "persistent-memory",
    "long-term-memory",
    "agent-continuity",
    "session-continuity",
    "agent-handoff",
    "agent-message-bus",
    "agent-coordination",
    "agent-interoperability",
    "coding-agents",
    "chatgpt-custom-instructions",
    "chatgpt-project-instructions"
  ],
  "entrypoints": {
    "generic": "AGENTS.md",
    "handshake": "AGENT_HANDSHAKE.md",
    "session_linking": "SESSION_LINKING.md",
    "message_bus": "AGENT_MESSAGE_BUS.md",
    "chatgpt_global_bootstrap": "CHATGPT_GLOBAL_BOOTSTRAP.md",
    "chatgpt_project_instructions": "CHATGPT_PROJECT_INSTRUCTIONS.md",
    "claude_code": "CLAUDE.md",
    "gemini_cli": "GEMINI.md",
    "github_copilot": ".github/copilot-instructions.md",
    "cursor": ".cursor/rules/agent-memory-hub.mdc",
    "multi_agent_protocol": "MULTI_AGENT.md",
    "rules": "AGENT_RULES.md",
    "registry": "agents/registry.json",
    "blackboard": "coordination/BLACKBOARD.md",
    "llm_index": "llms.txt"
  },
  "storage": {
    "per_agent": "agents/<agent-id>/",
    "per_session": "sessions/<session-id>/",
    "messages": "coordination/messages/",
    "acknowledgments": "coordination/acks/",
    "shared": "shared/",
    "coordination": "coordination/",
    "logs": "logs/"
  },
  "schemas": {
    "session": "schemas/session.schema.json",
    "message": "schemas/message.schema.json",
    "ack": "schemas/ack.schema.json"
  },
  "registration": {
    "allowed_for": "agents with legitimate owner-authorized write access",
    "registry": "agents/registry.json",
    "require_unique_agent_id": true,
    "fallback_handshake": "AGENT_HANDSHAKE.md"
  },
  "capabilities": [
    "durable-memory",
    "cross-invocation-continuity",
    "cross-chat-session-graph",
    "append-only-agent-messaging",
    "threaded-agent-replies",
    "message-acknowledgments",
    "multi-agent-handoff",
    "shared-knowledge",
    "git-audit-lineage",
    "public-agent-handshake",
    "global-chat-bootstrap-via-custom-instructions",
    "project-chat-bootstrap-via-project-instructions"
  ],
  "constraints": [
    "no-secrets",
    "no-permission-escalation",
    "no-covert-persistence",
    "no-shutdown-evasion",
    "owner-authorized-objectives-only"
  ]
}
