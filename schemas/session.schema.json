{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/namnx-vn/agent-memory-hub/schemas/session.schema.json",
  "title": "Agent Memory Hub Session",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "session_id", "agent_id", "kind", "status", "started_at", "parent_session_id", "continued_from", "summary", "last_seen_at"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "kind": {"enum": ["chat", "scheduled", "worker", "external-agent"]},
    "status": {"enum": ["active", "handoff", "closed"]},
    "started_at": {"type": "string"},
    "parent_session_id": {"type": ["string", "null"]},
    "continued_from": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "summary": {"type": "string"},
    "last_seen_at": {"type": "string"}
  }
}
